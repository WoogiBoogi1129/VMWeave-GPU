{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "torch-cpu",
    "namespace": "dp-torch-20261106",
    "labels": {
      "vmweave-experiment": "official-pytorch-20261106"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "activeDeadlineSeconds": 600,
    "terminationGracePeriodSeconds": 10,
    "nodeSelector": {
      "kubernetes.io/hostname": "dp-dev-20261105"
    },
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "fsGroup": 1000,
      "supplementalGroups": [
        998
      ],
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "pytorch",
        "image": "docker.io/pytorch/pytorch@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "/bin/sh",
          "-ec"
        ],
        "args": [
          "exec python -u /work/verify.py --mode cpu --profile default --hold-seconds 0"
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "env": [
          {
            "name": "HOME",
            "value": "/tmp"
          },
          {
            "name": "PYTHONDONTWRITEBYTECODE",
            "value": "1"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "2",
            "memory": "3Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "code",
            "mountPath": "/work",
            "readOnly": true
          },
          {
            "name": "results",
            "mountPath": "/results"
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "code",
        "configMap": {
          "name": "verify-code"
        }
      },
      {
        "name": "results",
        "emptyDir": {}
      },
      {
        "name": "tmp",
        "emptyDir": {}
      }
    ]
  }
}
