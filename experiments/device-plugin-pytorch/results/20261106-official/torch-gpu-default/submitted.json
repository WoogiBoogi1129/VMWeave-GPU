{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "torch-gpu-default",
    "namespace": "dp-torch-20261106",
    "labels": {
      "vmweave-experiment": "official-pytorch-20261106"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "activeDeadlineSeconds": 600,
    "terminationGracePeriodSeconds": 10,
    "nodeSelector": {
      "kubernetes.io/hostname": "dp-dev-20261105"
    },
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "fsGroup": 1000,
      "supplementalGroups": [
        998
      ],
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "pytorch",
        "image": "docker.io/pytorch/pytorch@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "/bin/sh",
          "-ec"
        ],
        "args": [
          "export LD_LIBRARY_PATH=\"/opt/vmweave/adapter${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"; exec python -u /work/verify.py --mode gpu --profile default --hold-seconds 60"
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "env": [
          {
            "name": "HOME",
            "value": "/tmp"
          },
          {
            "name": "PYTHONDONTWRITEBYTECODE",
            "value": "1"
          },
          {
            "name": "LD_PRELOAD",
            "value": "/opt/vmweave/adapter/libvmweave_guest.so"
          },
          {
            "name": "VMWEAVE_MIRROR_DEVICE_VA",
            "value": "1"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "2",
            "memory": "3Gi",
            "vmweave.io/gpu": 1
          }
        },
        "volumeMounts": [
          {
            "name": "code",
            "mountPath": "/work",
            "readOnly": true
          },
          {
            "name": "results",
            "mountPath": "/results"
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          },
          {
            "name": "adapter",
            "mountPath": "/opt/vmweave/adapter",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "code",
        "configMap": {
          "name": "verify-code"
        }
      },
      {
        "name": "results",
        "emptyDir": {}
      },
      {
        "name": "tmp",
        "emptyDir": {}
      },
      {
        "name": "adapter",
        "emptyDir": {}
      }
    ],
    "initContainers": [
      {
        "name": "guest-adapter",
        "image": "ghcr.io/woogiboogi1129/vmweave-device-plugin-guest@sha256:79d6c83dc938caf9e6d17b5ee06f4214170b63589b8f6bd635b9f6827559ece4",
        "imagePullPolicy": "IfNotPresent",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "command": [
          "sh",
          "-ec"
        ],
        "args": [
          "cp /opt/vmweave/guest/libvmweave_guest.so /adapter/; cd /adapter; echo \"32bf53906f6cd4fd681c7af9068aad6274ea8c972c31e57d5efaf009e74e1bc5  libvmweave_guest.so\" | sha256sum -c -; ln -s libvmweave_guest.so libcuda.so.1; chmod 0555 libvmweave_guest.so"
        ],
        "volumeMounts": [
          {
            "name": "adapter",
            "mountPath": "/adapter"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "200m",
            "memory": "64Mi"
          }
        }
      }
    ]
  }
}
