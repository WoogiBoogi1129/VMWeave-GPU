+/* Range lookup is restricted to allocations owned by this client map. */
+static uint64_t find_index(resource_map *map, void *addr) {
+    uint64_t v = (uintptr_t)addr;
+    for (uint64_t i = 1; i < map->tail_idx; ++i) {
+        resource_map_item *e = &map->list[i];
+        if (e->present && e->extent && v >= e->client_base &&
+            v - e->client_base < e->extent) return i;
+    }
+    uint64_t i = v - OFFSET;
+    return i > 0 && i < map->tail_idx && map->list[i].present &&
+           !map->list[i].extent ? i : 0;
+}
+
+resource_map_item *resource_map_get(resource_map *map, void *addr) {
+    pthread_mutex_lock(&map->mutex);
+    uint64_t i = find_index(map, addr);
+    resource_map_item *e = i ? &map->list[i] : NULL;
+    pthread_mutex_unlock(&map->mutex);
+    return e;
+}
+
+void *resource_map_get_addr(resource_map *map, void *addr) {
