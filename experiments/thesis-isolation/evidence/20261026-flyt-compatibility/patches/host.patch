+/* Non-migrating compatibility build: preserve CUDA pointer values even when
+ * nested in by-value kernel structs. Ownership/range lookup remains per client.
+ * CUDA may reuse an address after cudaFree, as in a native process. */
+int resource_map_add_range(resource_map *map, void *addr, void *args,
+                           uint64_t size, void **out) {
+    uint64_t base = (uintptr_t)addr;
+    if (!addr || !size || size > UINT64_MAX - base) return -1;
+    pthread_mutex_lock(&map->mutex);
+    for (uint64_t i = 1; i < map->tail_idx; ++i) {
+        resource_map_item *e = &map->list[i];
+        if (e->present && e->extent && base < e->client_base + e->extent &&
+            e->client_base < base + size) {
+            pthread_mutex_unlock(&map->mutex); return -1;
+        }
+    }
+    void *token;
+    int rc = resource_map_add(map, addr, args, &token);
+    if (!rc) {
+        resource_map_item *e = &map->list[resource_map_index_from_addr(token)];
+        e->client_base = base;
+        e->extent = size;
+        *out = addr;
+    }
+    pthread_mutex_unlock(&map->mutex);
+    return rc;
+}
+
+void resource_map_unset(resource_map *map, void *addr) {
+    pthread_mutex_lock(&map->mutex);
+    uint64_t idx = find_index(map, addr);
+    if (idx && (!map->list[idx].extent ||
+                map->list[idx].client_base == (uintptr_t)addr)) {
+        map->list[idx].mapped_addr = (void *)map->free_ptr_idx;
+        map->list[idx].present = 0;
+        free(map->list[idx].args);
+        map->list[idx].args = NULL;
+        map->free_ptr_idx = idx;
+    }
     pthread_mutex_unlock(&map->mutex);
 }
 
