+/* Flyt-only CUDA 12.8 runtime entrypoint compatibility. No native fallback. */
+#define _GNU_SOURCE
+#include <cuda_runtime_api.h>
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+
+struct entry { const char *base; const char *export; unsigned minimum; int stream_sensitive; };
+static const struct entry entries[] = {
+ {"cuDeviceGet", "cuDeviceGet", 2000, 0},
+ {"cuDeviceGetAttribute", "cuDeviceGetAttribute", 2000, 0},
+ {"cuCtxGetCurrent", "cuCtxGetCurrent", 4000, 0},
+ {"cuCtxSetCurrent", "cuCtxSetCurrent", 4000, 0},
+ {"cuGetErrorString", "cuGetErrorString", 6000, 0},
+};
+cudaError_t cudaGetDriverEntryPointByVersion(const char *symbol, void **out,
+ unsigned version, unsigned long long flags, enum cudaDriverEntryPointQueryResult *status)
+{
+ if (out) *out = NULL;
+ if (status) *status = cudaDriverEntryPointSymbolNotFound;
+ if (!symbol || !out || flags > cudaEnablePerThreadDefaultStream) return cudaErrorInvalidValue;
+ const struct entry *entry = NULL;
+ for (unsigned i=0; i<sizeof(entries)/sizeof(entries[0]); ++i)
+  if (!strcmp(symbol, entries[i].base)) {entry=&entries[i];break;}
+ if (!entry) return cudaSuccess; /* missing optional API: NULL + SymbolNotFound */
+ if (version < entry->minimum) {
+  if (status) *status = cudaDriverEntryPointVersionNotSufficent;
+  return cudaSuccess;
+ }
+ /* Fail closed on unknown future ABI rather than invent support. */
+ if (version > CUDART_VERSION) return cudaErrorNotSupported;
+ Dl_info own, found;
+ void *p=dlsym(RTLD_DEFAULT, entry->export);
+ if (!p || !dladdr((void *)&cudaGetDriverEntryPointByVersion,&own) ||
+     !dladdr(p,&found) || own.dli_fbase!=found.dli_fbase) return cudaErrorNotSupported;
+ *out=p;
+ if (status) *status=cudaDriverEntryPointSuccess;
+ return cudaSuccess;
+}
+cudaError_t cudaGetDriverEntryPoint(const char *symbol,void **out,
+ unsigned long long flags,enum cudaDriverEntryPointQueryResult *status)
+{
+ return cudaGetDriverEntryPointByVersion(symbol,out,CUDART_VERSION,flags,status);
+}
+
+/* New imports required by the fixed PyTorch build. Unsupported graph features
+ * fail explicitly; the eager workload must not silently rely on them. */
+cudaError_t cudaStreamGetCaptureInfo_v2(cudaStream_t stream,
+ enum cudaStreamCaptureStatus *status, unsigned long long *id,
+ cudaGraph_t *graph, const cudaGraphNode_t **dependencies, size_t *count)
+{
+ if (!status) return cudaErrorInvalidValue;
+ cudaError_t e=cudaStreamIsCapturing(stream,status);
+ if (e!=cudaSuccess) return e;
+ if (*status!=cudaStreamCaptureStatusNone) return cudaErrorNotSupported;
+ if(id)*id=0; if(graph)*graph=NULL; if(dependencies)*dependencies=NULL; if(count)*count=0;
+ return cudaSuccess;
+}
+cudaError_t cudaEventRecordWithFlags(cudaEvent_t event,cudaStream_t stream,unsigned flags)
+{ return flags ? cudaErrorNotSupported : cudaEventRecord(event,stream); }
+cudaError_t cudaGraphDebugDotPrint(cudaGraph_t graph,const char *path,unsigned flags)
+{ return cudaErrorNotSupported; }
+cudaError_t cudaGraphInstantiateWithFlags(cudaGraphExec_t *out,cudaGraph_t graph,unsigned long long flags)
+{ if(out)*out=NULL; return cudaErrorNotSupported; }
+cudaError_t cudaLaunchKernelExC(const cudaLaunchConfig_t *config,const void *func,void **args)
+{
+ if (!config || !func) return cudaErrorInvalidValue;
+ if (config->numAttrs) return cudaErrorNotSupported;
+ return cudaLaunchKernel(func,config->gridDim,config->blockDim,args,config->dynamicSmemBytes,config->stream);
+}
