+/* Per-process activity: an idle Worker must not bank future GPU runtime.
+ * Updated while waiting as well as submitting, so a throttled producer is
+ * never mistaken for an idle one. The 100% fast path remains unchanged. */
+static uint64_t g_last_activity_ns[CUDA_DEVICE_MAX_COUNT] = {0};
+static uint64_t monotonic_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+static int device_is_idle(int dev, int userutil, uint64_t now) {
+    uint64_t last = __atomic_load_n(&g_last_activity_ns[dev], __ATOMIC_RELAXED);
+    return userutil == 0 && (last == 0 || (now > last && now - last > 1000000000ULL));
+}
