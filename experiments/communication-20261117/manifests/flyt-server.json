{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "flyt-server",
    "namespace": "comm-20261117",
    "labels": {
      "experiment.vmweave.io/campaign": "comm-20261117"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "gpu-4"
    },
    "runtimeClassName": "nvidia",
    "schedulerName": "default-scheduler",
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 10,
    "automountServiceAccountToken": false,
    "resourceClaims": [
      {
        "name": "gpu",
        "resourceClaimName": "flyt-server"
      }
    ],
    "containers": [
      {
        "name": "main",
        "image": "localhost/flyt-gpu-cell@sha256:0b21e0df1222f5861b522994a80416e243870663372d3cd2a886d36a221efbbd",
        "command": [
          "taskset",
          "-c",
          "12-15",
          "/usr/local/bin/flyt-gpu-cell-entrypoint"
        ],
        "resources": {
          "claims": [
            {
              "name": "gpu"
            }
          ],
          "requests": {
            "cpu": "1",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "16Gi"
          }
        },
        "env": [
          {
            "name": "FLYT_ALLOWED_GPU_UUIDS",
            "value": "GPU-772181af-05a4-0c24-de59-8487bd37c142"
          },
          {
            "name": "FLYT_NODE_MANAGER_CONFIG",
            "value": "/etc/flyt/node-mgr.toml"
          },
          {
            "name": "RUST_LOG",
            "value": "info"
          }
        ],
        "volumeMounts": [
          {
            "name": "work",
            "mountPath": "/work"
          },
          {
            "name": "cfg",
            "mountPath": "/etc/flyt",
            "readOnly": true
          },
          {
            "name": "mps",
            "mountPath": "/run/flyt-mps"
          },
          {
            "name": "mps-log",
            "mountPath": "/var/log/flyt-mps"
          },
          {
            "name": "shm",
            "mountPath": "/dev/shm"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "work",
        "hostPath": {
          "path": "/home/ubuntu/taeuk/flyt-k8s-poc-github/.local/communication-20261117/artifacts",
          "type": "Directory"
        }
      },
      {
        "name": "cfg",
        "hostPath": {
          "path": "/home/ubuntu/taeuk/flyt-k8s-poc-github/.local/communication-20261117/flyt-config",
          "type": "Directory"
        }
      },
      {
        "name": "mps",
        "emptyDir": {}
      },
      {
        "name": "mps-log",
        "emptyDir": {}
      },
      {
        "name": "shm",
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "2Gi"
        }
      }
    ]
  }
}
