{
  "uid": "overhead",
  "title": "N / Flyt TCP / Proposed SHM \u2014 actual monitoring",
  "schemaVersion": 40,
  "version": 1,
  "timezone": "utc",
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU utilization (whole GPU)",
      "datasource": {
        "type": "prometheus",
        "uid": "perf-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perf_gpu_util_percent",
          "refId": "A",
          "legendFormat": "{{session}} {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU cores used (exclusive Pod cgroups)",
      "datasource": {
        "type": "prometheus",
        "uid": "perf-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(perf_pod_cpu_seconds_total[10s])",
          "refId": "A",
          "legendFormat": "{{session}} {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU memory (includes contexts)",
      "datasource": {
        "type": "prometheus",
        "uid": "perf-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perf_gpu_memory_mib",
          "refId": "A",
          "legendFormat": "{{session}} {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU SM clock",
      "datasource": {
        "type": "prometheus",
        "uid": "perf-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perf_gpu_sm_clock_mhz",
          "refId": "A",
          "legendFormat": "{{session}} {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:MHz",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "perf-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perf_gpu_temperature_c",
          "refId": "A",
          "legendFormat": "{{session}} {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Collector errors",
      "datasource": {
        "type": "prometheus",
        "uid": "perf-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perf_collector_errors",
          "refId": "A",
          "legendFormat": "{{session}} {{role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Measured windows",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "type": "tags",
          "tags": [
            "overhead"
          ],
          "limit": 1000
        }
      }
    ]
  }
}