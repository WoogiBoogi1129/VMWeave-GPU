.version 7.0
.target sm_70
.address_size 64
.visible .entry work(.param .u64 src,.param .u64 dst,.param .u32 reps){
.reg .u64 %s,%d,%off; .reg .u32 %i,%t,%b,%n,%reps,%r; .reg .pred %q;
ld.param.u64 %s,[src];ld.param.u64 %d,[dst];ld.param.u32 %reps,[reps];
mov.u32 %t,%tid.x;mov.u32 %b,%ctaid.x;mad.lo.u32 %i,%b,256,%t;
mul.wide.u32 %off,%i,4;add.u64 %s,%s,%off;add.u64 %d,%d,%off;mov.u32 %n,0;
ld.global.u32 %r,[%s];
loop: add.u32 %r,%r,19;add.u32 %n,%n,1;setp.lt.u32 %q,%n,%reps;@%q bra loop;
st.global.u32 [%d],%r;ret;}
