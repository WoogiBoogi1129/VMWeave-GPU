+/* Experiment-only: bounded in-memory records; no timed-loop file writes.
+ * Monotonic timestamps remain within their clock domain; IDs join endpoints. */
+#define _GNU_SOURCE
+#include "hd_diag.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
