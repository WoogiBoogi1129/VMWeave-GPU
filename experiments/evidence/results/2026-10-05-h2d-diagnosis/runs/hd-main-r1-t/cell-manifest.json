{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "hd-main-r1-t-cell",
    "namespace": "vmweave-test-a"
  },
  "spec": {
    "nodeName": "gpu-4",
    "runtimeClassName": "nvidia",
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 5,
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "cell",
        "image": "localhost/flyt-gpu-cell@sha256:0b21e0df1222f5861b522994a80416e243870663372d3cd2a886d36a221efbbd",
        "command": [
          "taskset",
          "-c",
          "16-19",
          "/usr/local/bin/flyt-gpu-cell-entrypoint"
        ],
        "env": [
          {
            "name": "NVIDIA_VISIBLE_DEVICES",
            "value": "k8s.device-plugin.nvidia.com/gpu=GPU-7d708c42-8d4a-16d5-0746-474567157aa3"
          },
          {
            "name": "NVIDIA_DRIVER_CAPABILITIES",
            "value": "compute,utility"
          },
          {
            "name": "FLYT_ALLOWED_GPU_UUIDS",
            "value": "GPU-7d708c42-8d4a-16d5-0746-474567157aa3"
          },
          {
            "name": "FLYT_NODE_MANAGER_CONFIG",
            "value": "/etc/flyt/node-mgr.toml"
          },
          {
            "name": "RUST_LOG",
            "value": "info"
          }
        ],
        "volumeMounts": [
          {
            "name": "cfg",
            "mountPath": "/etc/flyt",
            "readOnly": true
          },
          {
            "name": "shm",
            "mountPath": "/dev/shm"
          },
          {
            "name": "mps-run",
            "mountPath": "/run/flyt-mps"
          },
          {
            "name": "mps-log",
            "mountPath": "/var/log/flyt-mps"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "cfg",
        "hostPath": {
          "path": "/home/ubuntu/taeuk/flyt-k8s-poc-github/.local/h2d-diagnosis-20261005/legacy-config",
          "type": "Directory"
        }
      },
      {
        "name": "shm",
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "2Gi"
        }
      },
      {
        "name": "mps-run",
        "emptyDir": {}
      },
      {
        "name": "mps-log",
        "emptyDir": {}
      }
    ]
  }
}
