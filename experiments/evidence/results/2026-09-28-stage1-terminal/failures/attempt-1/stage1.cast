[3.737116, "o", "# 1. REGISTER GPU REQUEST: 4096 MiB / compute 50 / one session\r\n\u001b[?2004l\r"]
[3.737838, "o", "\u001b[?2004hubuntu@gpu-4:flyt-k8s-poc-github$ "]
[3.790057, "o", "cat \"$DEMO/prepare.sh\"\r\n\u001b[?2004l\r"]
[3.793403, "o", "#!/bin/bash\r\nset -euo pipefail\r\npython3 scripts/prepare-evidence-vm.py --name \"$VM\" \\\r\n  --reuse-pvc evidence-vm-a-backing --public-key \"$DEMO/artifacts/guest-key.pub\" \\\r\n  --memory-mib 4096 --compute 50 --sessions 1 \\\r\n  --guest-image \"$GUEST_IMAGE\" --worker-image \"$WORKER_IMAGE\" \\\r\n  --control-image \"$CONTROL_IMAGE\" --hook-image \"$HOOK_IMAGE\" \\\r\n  --output \"$DEMO/private-prepare\"\r\n"]
[3.79431, "o", "\u001b[?2004hubuntu@gpu-4:flyt-k8s-poc-github$ "]
[3.847378, "o", "bash \"$DEMO/prepare.sh\" | tee \"$RAW/create.log\"\r\n\u001b[?2004l\r"]
