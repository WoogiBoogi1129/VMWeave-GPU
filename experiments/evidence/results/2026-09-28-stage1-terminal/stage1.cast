[64.465078, "o", "#!/bin/bash\r\nset -euo pipefail\r\nhostname\r\ndate -u +%FT%TZ\r\ncd /tmp/campaign\r\nsudo env FLYT_LAYOUT=/tmp/campaign/layout.bin \\\r\n  FLYT_IVSHMEM_BDF=0000:00:1e.0 FLYT_SLOT=0 LD_LIBRARY_PATH=/tmp/campaign \\\r\n  ./campaign-probe-guest integer resident 45 0 64 2030 0 - -\r\n"]
