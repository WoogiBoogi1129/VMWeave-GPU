[64.51957, "o", "ssh -n -F \"$DEMO/ssh-config\" stage1-vm \"bash /tmp/campaign/run-probe.sh\" > \"$RAW/guest-stdout.log\" 2> \"$RAW/guest-stderr.log\" &\r\n\u001b[?2004l\r"]
