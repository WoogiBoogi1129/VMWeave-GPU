                    "apiVersion": "v1",
                    "fieldPath": "metadata.namespace"
                  }
                }
              },
              {
                "name": "HAMI_HOST_HOOK_PATH",
                "value": "/var/lib/vmweave-hami-dra"
              },
              {
                "name": "IMAGE_NAME",
                "value": "ghcr.io/woogiboogi1129/vmweave-hami-dra:v0.5.2@sha256:8f090c63aef50e60e810f1af18385c917bcb3a77b45ca9cfb47b671e236ec947"
              },
              {
                "name": "NVIDIA_CDI_HOOK_PATH",
                "value": "/usr/local/nvidia/toolkit/nvidia-ctk"
              },
              {
