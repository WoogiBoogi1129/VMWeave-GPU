{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "channelattachments.vmweave.io",
    "labels": {
      "app.kubernetes.io/part-of": "vmweave"
    }
  },
  "spec": {
    "group": "vmweave.io",
    "scope": "Namespaced",
    "names": {
      "kind": "ChannelAttachment",
      "plural": "channelattachments",
      "singular": "channelattachment",
      "listKind": "ChannelAttachmentList"
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "required": [
                  "channelRef",
                  "generation",
                  "role",
                  "holderUID",
                  "nodeName"
                ],
                "properties": {
                  "channelRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "generation": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "guest",
                      "worker"
                    ]
                  },
                  "holderUID": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeName": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "x-kubernetes-validations": [
                  {
                    "rule": "self.channelRef == oldSelf.channelRef && self.generation == oldSelf.generation && self.role == oldSelf.role && self.holderUID == oldSelf.holderUID && self.nodeName == oldSelf.nodeName",
                    "message": "allocation spec is immutable; create a new channel"
                  }
                ]
              },
              "status": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "evidence": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "reporterPodUID": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "launcherPodUID": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "observedGeneration": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  }
                }
              }
            },
            "required": [
              "spec"
            ]
          }
        },
        "additionalPrinterColumns": [
          {
            "name": "Phase",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Age",
            "type": "date",
            "jsonPath": ".metadata.creationTimestamp"
          }
        ]
      }
    ]
  }
}
