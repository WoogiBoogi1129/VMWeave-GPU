{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "sharedmemorychannels.vmweave.io",
    "labels": {
      "app.kubernetes.io/part-of": "vmweave"
    }
  },
  "spec": {
    "group": "vmweave.io",
    "scope": "Namespaced",
    "names": {
      "kind": "SharedMemoryChannel",
      "plural": "sharedmemorychannels",
      "singular": "sharedmemorychannel",
      "listKind": "SharedMemoryChannelList"
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "required": [
                  "vmRef",
                  "requestRef",
                  "pvcRef",
                  "sessions",
                  "uid",
                  "gid",
                  "image",
                  "workerImage",
                  "hookImage"
                ],
                "properties": {
                  "vmRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "requestRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "pvcRef": {
                    "type": "object",
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uid": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "sessions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  },
                  "uid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "image": {
                    "type": "string",
                    "pattern": ".+@sha256:[0-9a-f]{64}$"
                  },
                  "workerImage": {
                    "type": "string",
                    "pattern": ".+@sha256:[0-9a-f]{64}$"
                  },
                  "hookImage": {
                    "type": "string",
                    "pattern": ".+@sha256:[0-9a-f]{64}$"
                  },
                  "drain": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "x-kubernetes-validations": [
                  {
                    "rule": "self.vmRef == oldSelf.vmRef && self.requestRef == oldSelf.requestRef && self.pvcRef == oldSelf.pvcRef && self.sessions == oldSelf.sessions && self.uid == oldSelf.uid && self.gid == oldSelf.gid && self.image == oldSelf.image && self.workerImage == oldSelf.workerImage && self.hookImage == oldSelf.hookImage",
                    "message": "allocation spec is immutable; create a new channel"
                  }
                ]
              },
              "status": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "allocation": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "generation": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "nodeName": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "gpuUUID": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "vmiUID": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "workerPodUID": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "mode": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "observedGeneration": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "memoryMiB": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "compute": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "requestGeneration": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "profileGeneration": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "everBound": {
                    "type": "boolean"
                  },
                  "sessions": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string"
                    }
                  },
                  "conditions": {
                    "type": "array",
                    "maxItems": 16,
                    "x-kubernetes-list-type": "map",
                    "x-kubernetes-list-map-keys": [
                      "type"
                    ],
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "status",
                        "reason",
                        "message",
                        "lastTransitionTime",
                        "observedGeneration"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "True",
                            "False",
                            "Unknown"
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "message": {
                          "type": "string",
                          "maxLength": 2048
                        },
                        "lastTransitionTime": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "observedGeneration": {
                          "type": "integer",
                          "format": "int64"
                        }
                      }
                    }
                  },
                  "resourcePrefix": {
                    "type": "string",
                    "maxLength": 63,
                    "description": "UID-qualified child resource prefix; absent on older allocations."
                  }
                }
              }
            },
            "required": [
              "spec"
            ]
          }
        },
        "additionalPrinterColumns": [
          {
            "name": "Phase",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Age",
            "type": "date",
            "jsonPath": ".metadata.creationTimestamp"
          }
        ]
      }
    ]
  }
}
