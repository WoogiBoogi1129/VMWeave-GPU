{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "review",
        "active"
      ]
    },
    "management": {
      "type": "object",
      "required": [
        "namespaces"
      ],
      "properties": {
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "leaderElection": {
          "type": "boolean"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "existingSecret",
            "certManager"
          ]
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "certManager": {
          "type": "object",
          "properties": {
            "issuerRef": {
              "type": "object",
              "required": [
                "name",
                "kind",
                "group"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                },
                "group": {
                  "const": "cert-manager.io"
                }
              }
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tolerations": {
          "type": "array"
        }
      }
    }
  },
  "required": [
    "mode",
    "management",
    "image"
  ]
}
