include_guard(GLOBAL)
# Legacy cache options remain inputs only when the canonical option is absent.
foreach(option BUILD_CUDA_RUNTIME CUDNN)
  if(DEFINED FLYT_${option} AND NOT DEFINED VMWEAVE_${option})
    set(VMWEAVE_${option} "${FLYT_${option}}" CACHE STRING "Legacy option migration")
  endif()
endforeach()
function(vmweave_legacy_target target legacy)
  get_target_property(kind ${target} TYPE)
  if(kind STREQUAL "EXECUTABLE")
    add_executable(${legacy} ALIAS ${target})
    set(old_name ${legacy})
    set(destination bin)
  else()
    add_library(${legacy} ALIAS ${target})
    if(kind STREQUAL "STATIC_LIBRARY")
      set(old_name "lib${legacy}.a")
    else()
      set(old_name "lib${legacy}.so")
    endif()
    set(destination lib)
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E create_symlink "$<TARGET_FILE_NAME:${target}>" "$<TARGET_FILE_DIR:${target}>/${old_name}")
  if(NOT kind STREQUAL "STATIC_LIBRARY")
    install(CODE "file(CREATE_LINK \"$<TARGET_FILE_NAME:${target}>\" \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${destination}/${old_name}\" SYMBOLIC)")
  endif()
endfunction()
